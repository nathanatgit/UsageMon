<UserControl x:Class="UsageMon.Controls.BalanceBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="96" Height="96" IsTabStop="True" UseSystemFocusVisuals="False">
    <Grid Background="Transparent">
        <Ellipse x:Name="Ring" Width="78" Height="78" StrokeThickness="3" Stroke="{ThemeResource SystemControlHighlightAccentBrush}" Opacity="0.25" />
        <Grid x:Name="Rings" Visibility="Collapsed">
            <Path x:Name="OuterTrack" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="3" Opacity="0.12" />
            <Path x:Name="InnerTrack" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="3" Opacity="0.12" />
            <Path x:Name="OuterArc" Stroke="{ThemeResource SystemControlHighlightAccentBrush}" StrokeThickness="3"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Path x:Name="InnerArc" Stroke="{ThemeResource SystemControlHighlightAccentBrush}" StrokeThickness="3"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.55" />
        </Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
            <Viewbox Width="26" Height="26" HorizontalAlignment="Center">
                <Canvas Width="24" Height="24"><Path x:Name="Logo" Fill="{ThemeResource TextFillColorPrimaryBrush}" /></Canvas>
            </Viewbox>
            <Viewbox x:Name="AmountBox" MaxWidth="56" StretchDirection="DownOnly">
                <TextBlock x:Name="Amount" Text="–" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Viewbox>
        </StackPanel>
    </Grid>
</UserControl>
