<Window x:Class="UsageMon.TaskbarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:UsageMon.Controls">
    <Grid x:Name="Root" Background="Transparent">
        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="Settings" Click="Settings_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                <MenuFlyoutItem Text="Refresh usage" Click="Refresh_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" Click="Exit_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>
        <StackPanel x:Name="Strip" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Center">
            <StackPanel x:Name="CodexItem" Orientation="Horizontal" Spacing="3">
                <Viewbox x:Name="CodexBox"><controls:QuotaBadge x:Name="CodexReadout" /></Viewbox>
                <TextBlock x:Name="CodexText" VerticalAlignment="Center" IsHitTestVisible="False" />
            </StackPanel>
            <StackPanel x:Name="ClaudeItem" Orientation="Horizontal" Spacing="3">
                <Viewbox x:Name="ClaudeBox"><controls:QuotaBadge x:Name="ClaudeReadout" /></Viewbox>
                <TextBlock x:Name="ClaudeText" VerticalAlignment="Center" IsHitTestVisible="False" />
            </StackPanel>
            <Viewbox x:Name="DeepSeekBox"><controls:BalanceBadge x:Name="DeepSeekReadout" /></Viewbox>
            <Viewbox x:Name="KimiBox"><controls:BalanceBadge x:Name="KimiReadout" /></Viewbox>
        </StackPanel>
    </Grid>
</Window>
